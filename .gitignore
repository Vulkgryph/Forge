# Rust build artifacts (shared workspace target/)
/target

# OS / editor cruft
.DS_Store

# Runtime session/conversation state (agent, IDE, and dev-tooling variants)
.forge/
.agent/
.opencode/
.claude/
.aider*/
.bob/
.bobsync/

# Anything that could carry a credential. Nothing has ever slipped past — this is
# insurance against the accident, not a record of one. A key committed to a public
# repository is not undone by deleting it in the next commit.
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
*_history

# Logs and scratch output
*.log
Screenshot*.png
*.txt

# Dependency trees from other ecosystems, in case anything is ever prototyped here
node_modules/
.venv/
__pycache__/
