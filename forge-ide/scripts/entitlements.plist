<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Forge IDE loads user-authored plugin dylibs from
         ~/.config/forge-ide/plugins/*.so (src/plugin.rs, PluginHost::load).
         These can never be signed by our Developer ID, so default Hardened
         Runtime library validation must be relaxed for plugin loading to work. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
